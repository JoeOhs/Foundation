# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust / Tauri
src-tauri/target
src-tauri/gen

# Data-prep raw/intermediate files (large binaries, not needed at runtime)
tools/companion-bible-notes/thecompanionbible_202504/
tools/companion-bible-notes/thecompanionbible_202504_epub/
tools/companion-bible-notes/thecompanionbible_202504_pdf/
tools/companion-bible-notes/thecompanionbible_202504_json/
# Talmud scrape cache: ~64MB of tractate JSON plus one file per daf of link
# data. Rebuildable with tools/talmud/build.mjs.
tools/talmud/raw/
# Yerushalmi download cache: one JSON per tractate from Sefaria's export
# bucket. Rebuildable with tools/yerushalmi/build.mjs.
tools/yerushalmi/raw/
# Calvin's Commentaries ThML cache: 45 volumes, ~63MB of XML from CCEL.
# Rebuildable with tools/calvin-commentaries/build.mjs.
tools/calvin-commentaries/raw/
# The build's own copy of the bundles it deploys — byte-identical to
# public/library/commentaries/calvin/, which is what actually ships.
tools/calvin-commentaries/bundles/
# Calvin's Institutes ThML cache: one ~5MB XML from CCEL.
# Rebuildable with tools/calvin-institutes/build.mjs.
tools/calvin-institutes/raw/
# The build's own copy of the bundle it deploys - byte-identical to
# public/library/reformation/institutes.json, which is what actually ships.
tools/calvin-institutes/institutes.json

# Local AI-assistant/session artifacts
.claude/
.agents/
skills-lock.json

